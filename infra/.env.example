# Copy to .env and fill in. Never commit the .env file.

# Cloudflare Tunnel token from the Zero Trust dashboard
# (Networks → Tunnels → your tunnel → Install connector → "docker" tab).
TUNNEL_TOKEN=

# Shared guest password (used for the /guest UI in Phase C).
GUEST_PASSWORD=changeme

# Matrix and Tapo addresses on the LAN.
MATRIX_HOST=192.168.8.241
MATRIX_PORT=23
TAPO_HOST=192.168.8.109

# Tapo (TP-Link) cloud account that owns the smart plugs.
# Recommended: a dedicated account, not your personal TP-Link login.
TAPO_EMAIL=
TAPO_PASSWORD=
