# Copy to .env and fill in. Never commit the .env file.

# Cloudflare Tunnel token from the Zero Trust dashboard
# (Networks → Tunnels → your tunnel → Install connector → "docker" tab).
TUNNEL_TOKEN=

# Shared guest password. Required.
GUEST_PASSWORD=changeme

# Used to sign the guest session cookie. If unset, a random one is generated
# on startup (sessions won't survive restarts). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Matrix and Tapo addresses on the LAN.
MATRIX_HOST=192.168.8.241
MATRIX_PORT=23
TAPO_HOST=192.168.8.109

# Tapo (TP-Link) cloud account that owns the smart plugs.
# Recommended: a dedicated account, not your personal TP-Link login.
TAPO_EMAIL=
TAPO_PASSWORD=

# WiFi credentials shown on /wifi (with QR code generated from these).
# WIFI_AUTH is one of WPA / WEP / nopass (default WPA).
WIFI_SSID=
WIFI_PASSWORD=
WIFI_AUTH=WPA

# Optional: visitors connecting from this WAN IP skip the guest password.
# If unset, the app auto-detects via the NAS's own outbound IP and refreshes
# every hour. Set explicitly only if auto-detection is unreliable.
HOME_PUBLIC_IP=

# Optional: pre-set the Elgato Key Light's LAN IP to skip in-app discovery.
# If unset, you can find + save the light from the Office picker page.
ELGATO_HOST=

# Neewer BLE-light bridge. The bridge runs on a host with Bluetooth (the
# Mac, or a Raspberry Pi). Source: bridge/neewer/. URL like:
#   NEEWER_BRIDGE_URL=http://192.168.8.196:8765
NEEWER_BRIDGE_URL=
